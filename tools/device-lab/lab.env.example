# Copy to lab.env (gitignored) and fill in. lab.sh reads it on the Mac.
# The lab machine as ssh reaches it: user@address, or an alias from ~/.ssh/config.
LAB_HOST=lab-host
# Optional:
# LAB_DIR=/home/<user>/apps/slopify-lab   (on the lab host; default ~/apps/slopify-lab)
# DEV_PORT=8190                           (the fixture server the emulators use)
# LANE_PORT=8180                          (browser lanes use LANE_PORT..LANE_PORT+3)
