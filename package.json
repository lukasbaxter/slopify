{
  "name": "slopify",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted music server + Spotify-style clients. One container, your music folder.",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "npm run dev -w server",
    "build": "npm run build -w server && npm run build -w web",
    "test": "npm test -w server",
    "e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx,.mjs",
    "fixtures": "node fixtures/generate.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=20" }
}
