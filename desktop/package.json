{
  "name": "slopify-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Slopify desktop: the web app in a window, with Chromecast and BluOS speakers driven from this machine (for speakers away from home; at home the server drives them).",
  "main": "electron/main.js",
  "scripts": {
    "dev": "SLOPIFY_DEV=1 electron .",
    "start": "electron .",
    "web": "node copy-web.js",
    "dist:mac": "npm run web && electron-builder -m",
    "dist:win": "npm run web && electron-builder -w",
    "dist:linux": "npm run web && electron-builder -l"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "castv2-client": "^1.2.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.baxtergroup.slopify",
    "productName": "Slopify",
    "files": ["electron/**/*", "dist/**/*", "package.json"],
    "directories": { "output": "release", "buildResources": "build" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.music", "identity": null },
    "win": { "target": ["nsis", "portable"] },
    "linux": { "target": ["AppImage", "deb"], "category": "Audio" },
    "afterPack": "build/adhoc-sign.js"
  }
}
