+// Slopify: the system-wide volume change, from AVSystemController. outputVolume
+// KVO only reports while THIS app's audio session is active, and the WebView's
+// playback session interrupts it (iOS log: "com.apple.WebKit 'MediaPlayback'
+// INTERRUPTING Slopify"), so the hardware buttons went unheard. The system
+// notification arrives whatever the session state. Once it is seen, KVO
+// stays quiet so a press is not reported twice.
+- (void)subscribeSystemVolume {
+  Class avsc = NSClassFromString(@"AVSystemController");
+  SEL sharedSel = NSSelectorFromString(@"sharedAVSystemController");
+  SEL setAttr = NSSelectorFromString(@"setAttribute:forKey:error:");
+  if (avsc && [avsc respondsToSelector:sharedSel]) {
+    id shared = ((id (*)(id, SEL))objc_msgSend)(avsc, sharedSel);
+    if (shared && [shared respondsToSelector:setAttr]) {
+      NSError *err = nil;
+      ((BOOL (*)(id, SEL, id, id, NSError **))objc_msgSend)(shared, setAttr, @[ @"SystemVolumeDidChange" ], @"AVSystemController_SubscribeToNotificationsAttribute", &err);
+    }
+  }
+  NSNotificationCenter *nc = [NSNotificationCenter defaultCenter];
+  [nc addObserver:self selector:@selector(systemVolumeDidChange:) name:@"SystemVolumeDidChange" object:nil];
+  [nc addObserver:self selector:@selector(systemVolumeDidChange:) name:@"AVSystemController_SystemVolumeDidChangeNotification" object:nil];
+}
+
+- (void)systemVolumeDidChange:(NSNotification *)notification {
+  NSDictionary *info = notification.userInfo;
+  id category = info[@"AudioCategory"] ?: info[@"AVSystemController_AudioCategoryNotificationParameter"];
+  if ([category isKindOfClass:[NSString class]] && [category rangeOfString:@"Ringtone"].location != NSNotFound) return;
+  id volume = info[@"Volume"] ?: info[@"AVSystemController_AudioVolumeNotificationParameter"];
+  if (![volume isKindOfClass:[NSNumber class]]) return;
+  sysVolSeen = YES;
+  // Slopify: why it changed. "ExplicitVolumeChange" is a button press (or a
+  // volume set by an app); route and category switches report other reasons
+  // and were being taken for presses.
+  id reason = info[@"Reason"] ?: info[@"AVSystemController_AudioVolumeChangeReasonNotificationParameter"];
+  if (hasListeners) {
+    [self sendEventWithName:@"RNVMEventVolume" body:@{
+      @"volume" : volume,
+      @"reason" : [reason isKindOfClass:[NSString class]] ? reason : @"",
+      @"category" : [category isKindOfClass:[NSString class]] ? category : @"",
+    }];
+  }
+}
+
