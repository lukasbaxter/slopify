{
  "name": "slopify",
  "private": true,
  "version": "0.1.81",
  "description": "Self-hosted music server + Spotify-style clients. One container, your music folder.",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w server",
    "build": "npm run build -w server && npm run build -w web",
    "test": "npm test -w server",
    "e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx,.mjs",
    "fixtures": "node fixtures/generate.mjs",
    "licenses": "node tools/third-party-licenses.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukasbaxter/slopify.git"
  },
  "homepage": "https://github.com/lukasbaxter/slopify",
  "bugs": {
    "url": "https://github.com/lukasbaxter/slopify/issues"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 120,
    "semi": true
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "env": {
      "node": true,
      "es2022": true,
      "browser": true
    },
    "ignorePatterns": [
      "dist",
      "node_modules",
      "fixtures/music"
    ],
    "rules": {
      "@typescript-eslint/no-explicit-any": "off"
    }
  }
}
