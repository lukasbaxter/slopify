<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The simulator honours ad-hoc-signed entitlements, so mrctl can read Now
     Playing and send commands like SpringBoard's lock screen does. -->
<plist version="1.0"><dict>
	<key>com.apple.mediaremote.now-playing-read-access</key><true/>
	<key>com.apple.mediaremote.full-now-playing-read-access</key><true/>
	<key>com.apple.mediaremote.send-commands</key><true/>
	<key>com.apple.mediaremote.ui-control</key><true/>
</dict></plist>
